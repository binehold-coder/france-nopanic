# Non-secret settings. Committed to git; every deploy copies them into /opt/france_nopanic/.env.
# Secrets (bot token, Anthropic key) come from GitHub Actions secrets, never from this file.

# owner = bot answers only the owner (testing); public = everyone
ACCESS_MODE=owner
CHANNEL=@france_nopanic
LETTER_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-5-5
FREE_LETTERS=3
TIMEZONE=Europe/Paris
REMINDER_HOUR=10

# Channel news: 10 posts/day (5 France, 4 Europe/world, 1 light), preview to owner before each
NEWS_ENABLED=1
NEWS_MODEL=claude-sonnet-5-5
NEWS_PREVIEW_MIN=30
